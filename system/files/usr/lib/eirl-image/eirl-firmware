#!/bin/bash
# eirl-firmware — the Jetson Nano's boot firmware (QSPI) on the image (IMAGE.md §4, decision D-I2).
#   eirl-firmware check    read the versions in the QSPI (VER and VER_b), read only, and record them
#   eirl-firmware auto     check; if they are not this image's L4T and the image allows it, update with NVIDIA's own
#                          updater and payload, check again and reboot (eirl-firmware.service, until it is done)
# NVIDIA's every-boot service (nv-l4t-bootloader-config) is masked in the image: this is the only path that writes
# the QSPI. What the image allows is in /usr/lib/eirl-image/firmware-mode: "update" in published images, "check" in
# test images (they never write the QSPI, whatever they read). An update that fails or is interrupted (VER_b written
# first, VER last) is tried again at the next boots, at most MAX_ATTEMPTS times; then it stays "failed" for a person.
# State for the app and for people: /var/lib/eirl-image/firmware.json; done marker: firmware.done.
set -uo pipefail
DIR=/var/lib/eirl-image
STATE=$DIR/firmware.json
MODE=$(cat /usr/lib/eirl-image/firmware-mode 2>/dev/null || echo check)
NV_SCRIPT=/opt/nvidia/l4t-bootloader-config/nv-l4t-bootloader-config.sh
MAX_ATTEMPTS=3
log() { echo "eirl-firmware: $*"; }

# The L4T release in a 32 KiB version partition of the QSPI (VER at 0x3F0000, VER_b at 0x3E0000):
# "NV3 / # R32 , REVISION: 7.6" (R32.3 on) or "#R32 (release), REVISION: 2.x," (older). Prints e.g. 32.7.6, or
# "old" when there is no version (JetPack ≤ 4.2, or erased).
ver_at() { # 32 KiB block index
  local txt r
  txt=$(dd if=/dev/mtd0 bs=32K skip="$1" count=1 status=none 2>/dev/null | tr -d '\000' | tr -c '[:print:]\n' '\n')
  r=$(printf '%s\n' "$txt" | sed -nE 's/.*R([0-9]+)[^,]*, REVISION: ([0-9]+)\.([0-9]+).*/\1.\2.\3/p' | head -1)
  echo "${r:-old}"
}

write_state() { # action ver verb want [detail]
  local tmp
  tmp=$(mktemp "$DIR/.firmware.XXXXXX") || return
  printf '{"checkedAt":"%s","mode":"%s","action":"%s","qspi":{"ver":"%s","verB":"%s"},"image":"%s","attempts":%s,"detail":"%s"}\n' \
    "$(date -u +%FT%TZ)" "$MODE" "$1" "$2" "$3" "$4" "$(cat "$DIR/firmware.attempts" 2>/dev/null || echo 0)" "${5:-}" \
    > "$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$STATE"
}
done_() { touch "$DIR/firmware.done"; }

cmd=${1:-check}
case "$cmd" in check|auto) ;; *) echo "usage: eirl-firmware check|auto" >&2; exit 64 ;; esac
mkdir -p "$DIR"
# The QSPI's MTD device can appear a little after sysinit
for _ in $(seq 1 15); do [ -c /dev/mtd0 ] && break; sleep 1; done
if [ ! -c /dev/mtd0 ]; then
  log "no QSPI (/dev/mtd0): nothing to check (tried again at the next boot)"; write_state no_qspi "" "" ""; exit 0
fi
want=$(dpkg-query -W -f '${Version}' nvidia-l4t-bootloader 2>/dev/null | cut -d- -f1)
[ -n "$want" ] || { log "nvidia-l4t-bootloader is not installed"; write_state error "" "" "" no_package; exit 1; }
ver=$(ver_at 126); verb=$(ver_at 124)
log "QSPI VER=$ver VER_b=$verb, image L4T $want, mode $MODE"
if [ "$ver" = "$want" ] && [ "$verb" = "$want" ]; then
  write_state none "$ver" "$verb" "$want"; [ "$cmd" = auto ] && done_; exit 0
fi
if [ "$cmd" = check ] || [ "$MODE" != update ]; then
  log "the QSPI is not $want: NOT updated ($cmd, mode $MODE)"
  write_state needed "$ver" "$verb" "$want"
  [ "$cmd" = auto ] && done_        # a test image never writes it: nothing to try again
  exit 0
fi
attempts=$(cat "$DIR/firmware.attempts" 2>/dev/null || echo 0)
[[ $attempts =~ ^[0-9]+$ ]] || attempts=0
if [ "$attempts" -ge "$MAX_ATTEMPTS" ]; then
  log "the QSPI is not $want after $attempts attempts: NOT tried again (it needs a person: IMAGE.md §4)"
  write_state failed "$ver" "$verb" "$want" gave_up; exit 1
fi
echo $((attempts + 1)) > "$DIR/firmware.attempts"; sync

# Update: NVIDIA's own script (EEPROM, board spec, version comparison, dpkg-reconfigure of the bootloader and xusb
# packages = l4t_payload_updater_t210 on NVIDIA's payloads), run by hand here; its unit stays masked. It needs the
# udev links of the card's partitions and i2c-dev (the board EEPROM).
log "updating the QSPI from $ver to $want (attempt $((attempts + 1))): about 2 minutes, the power must stay connected"
write_state updating "$ver" "$verb" "$want"
# TODO(I2): the message on the screen while it writes (the boot splash has no free-text mode yet)
udevadm settle --timeout=30 || true
modprobe i2c-dev 2>/dev/null || true
# NVIDIA's updater starts with #!/usr/bin/python (python2, not in the image); it runs on python3 too, so the link
# exists only while the update runs
pylink=""
if [ ! -e /usr/bin/python ]; then ln -s python3 /usr/bin/python && pylink=1; fi
trap '[ -n "$pylink" ] && rm -f /usr/bin/python' EXIT
"$NV_SCRIPT"; rc=$?
[ -n "$pylink" ] && rm -f /usr/bin/python && pylink=""
ver=$(ver_at 126); verb=$(ver_at 124)
if [ "$rc" != 0 ] || [ "$ver" != "$want" ] || [ "$verb" != "$want" ]; then
  log "update FAILED (rc $rc; QSPI now VER=$ver VER_b=$verb): tried again at the next boot"
  write_state failed "$ver" "$verb" "$want" "rc_$rc"; exit 1
fi
write_state updated "$ver" "$verb" "$want"
done_
log "QSPI updated to $want: rebooting to use it"
sync
systemctl --no-block reboot
