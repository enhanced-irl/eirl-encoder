#!/usr/bin/env python3
# eirl-enginectl — manda órdenes al mezclador de eirl-engine (MIXER=1) por su socket y enseña su
# estado: lo mismo que la pantalla táctil y la web. Para probar y para la prueba larga.
#
#   eirl-enginectl state                  # estado (JSON)
#   eirl-enginectl watch                  # estado cada vez que cambia
#   eirl-enginectl take 2                 # al aire: número de hueco, id («hdmi», ruta by-id) o parte del nombre
#   eirl-enginectl secondary 1 | swap
#   eirl-enginectl layout full|pip|side
#   eirl-enginectl transition cut|fade
#   eirl-enginectl audio i2s|alsa:<tarjeta>|none|<parte del nombre>   # el audio al aire
#   eirl-enginectl audio-follow on|off    # «el audio sigue al vídeo»
#   eirl-enginectl audio-delay <audio> <ms>     # retardo de una entrada (0-500 ms)
#   eirl-enginectl audio-link <vídeo> <audio>|none   # el audio de una fuente de vídeo
#   eirl-enginectl phones on|off          # los auriculares de la pantalla (el programa por la HDMI)
#   eirl-enginectl phones-gain <dB>       # su volumen, de -40 (silencio) a 0
#   eirl-enginectl pip tl|tr|bl|br [25|33]  # esquina y ancho (%) del PiP
#   eirl-enginectl pause on|off ["texto"] # la Pausa (imagen fija encima de todo)
#   eirl-enginectl lock on|off            # bloquear la pantalla táctil
#   eirl-enginectl output on|off          # emitir / dejar de emitir en caliente (solo el motor: la
#                                               # app guarda OUTPUT aparte; para el uso normal, la web)
#   eirl-enginectl record on|off          # local recording (RECORDING.md §5.2): refused with REC_MODE=off or no disk
#   eirl-enginectl auto 5 [minutos]       # cambia de escena cada 5 s (fuentes, composición, transición)
#   eirl-enginectl camera 2               # a USB camera's image settings (SOURCES.md §7), as JSON
#   eirl-enginectl camera 2 brightness 140   # change one (an integer; a switch is 0 or 1)
#   eirl-enginectl camera-reset 2         # every setting back to the camera's default
import argparse
import json
import socket
import sys
import time


class Client(object):
    def __init__(self, path):
        self.s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.s.connect(path)
        self.f = self.s.makefile('rb')
        self.n = 0

    def call(self, cmd, **kw):
        self.n += 1
        kw.update(cmd=cmd, id=self.n)
        self.s.sendall((json.dumps(kw) + '\n').encode())
        while True:
            line = self.f.readline()
            if not line:
                raise SystemExit('el mezclador ha cerrado el socket')
            msg = json.loads(line.decode())
            if msg.get('id') == self.n:
                return msg


def resolve(state, what):
    srcs = state.get('sources', [])
    if what.isdigit():
        for s in srcs:
            if s['slot'] == int(what):
                return s['id']
    for s in srcs:
        if what == s['id']:
            return s['id']
    for s in srcs:
        if what.lower() in s['name'].lower():
            return s['id']
    raise SystemExit('no hay ninguna fuente «%s» (huecos: %s)' % (
        what, ', '.join('%d %s' % (s['slot'], s['name']) for s in srcs) or 'ninguno'))


def summary(st):
    p = st['program']
    names = {s['id']: s['name'] for s in st['sources']}
    srcs = ' | '.join('%d %s %s %.0f fps' % (s['slot'], s['name'], s['state'], s['fps']) for s in st['sources'])
    o = st.get('output', {})
    r = st.get('record')
    rec = ' | rec %s/%s%s' % (r.get('mode'), r.get('state'), ' (%s)' % r['reason'] if r.get('reason') else '') if r else ''
    return '%s al aire %s, 2.ª %s, %s, programa %s fps | %s | pantalla %s | salida %s/%s%s%s' % (
        time.strftime('%H:%M:%S'), names.get(p['main'], p['main']), names.get(p['secondary'], p['secondary']),
        p['layout'] + '/' + p['transition'], p.get('measuredFps'), srcs, st['screen']['state'],
        o.get('mode'), o.get('state'), ' (%s)' % o['reason'] if o.get('reason') else '', rec)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--sock', default='/run/eirl-engine/mixer.sock')
    ap.add_argument('cmd')
    ap.add_argument('args', nargs='*')
    a = ap.parse_args()
    c = Client(a.sock)
    if a.cmd == 'state':
        print(json.dumps(c.call('get')['state'], indent=2, ensure_ascii=False))
        return 0
    if a.cmd == 'watch':
        print(summary(c.call('subscribe')['state']), flush=True)
        for line in c.f:
            msg = json.loads(line.decode())
            if msg.get('event') == 'state':
                print(summary(msg['state']), flush=True)
        return 0
    if a.cmd == 'auto':
        every = float(a.args[0]) if a.args else 5
        end = time.monotonic() + float(a.args[1]) * 60 if len(a.args) > 1 else None
        steps = [('layout', {'layout': 'full'}), ('take', None), ('layout', {'layout': 'pip'}), ('swap', {}),
                 ('layout', {'layout': 'side'}), ('transition', None), ('take', None)]
        i = 0
        while end is None or time.monotonic() < end:
            st = c.call('get')['state']
            cmd, kw = steps[i % len(steps)]
            if cmd == 'take':
                ids = [s['id'] for s in st['sources']]
                if len(ids) > 1:
                    cur = ids.index(st['program']['main']) if st['program']['main'] in ids else -1
                    kw = {'source': ids[(cur + 1) % len(ids)]}
                else:
                    kw = None
            elif cmd == 'transition':
                kw = {'transition': 'cut' if st['program']['transition'] == 'fade' else 'fade'}
            if kw is not None:
                r = c.call(cmd, **kw)
                if not r.get('ok'):
                    print('%s %s → %s' % (cmd, kw, r.get('error')), file=sys.stderr)
            print(summary(c.call('get')['state']), flush=True)
            i += 1
            time.sleep(every)
        return 0
    kw = {}
    if a.cmd in ('take', 'secondary'):
        if not a.args:
            ap.error('falta la fuente')
        kw['source'] = resolve(c.call('get')['state'], a.args[0])
    elif a.cmd == 'layout':
        kw['layout'] = a.args[0] if a.args else ''
    elif a.cmd == 'transition':
        kw['transition'] = a.args[0] if a.args else ''
    elif a.cmd == 'audio':
        if not a.args:
            ap.error('audio i2s|alsa:<tarjeta>|none|<nombre>')
        want = a.args[0]
        if want not in ('none', 'i2s') and not want.startswith('alsa:'):
            srcs = (c.call('get')['state'].get('audio') or {}).get('sources', [])
            m = [x['id'] for x in srcs if want.lower() in x['name'].lower()]
            if not m:
                raise SystemExit('no hay audio «%s»: %s' % (want, ', '.join('%s (%s)' % (x['name'], x['id']) for x in srcs)))
            want = m[0]
        kw['source'] = want
    elif a.cmd in ('audio-follow', 'audio-delay', 'audio-link'):
        st = c.call('get')['state']
        srcs = (st.get('audio') or {}).get('sources', [])

        def audio_id(want):
            if want in ('none', 'i2s') or want.startswith('alsa:'):
                return want
            m = [x['id'] for x in srcs if want.lower() in x['name'].lower()]
            if not m:
                raise SystemExit('no hay audio «%s»: %s' % (want, ', '.join('%s (%s)' % (x['name'], x['id']) for x in srcs)))
            return m[0]
        if a.cmd == 'audio-follow':
            if not a.args or a.args[0] not in ('on', 'off'):
                ap.error('audio-follow on|off')
            kw['on'] = a.args[0] == 'on'
        elif a.cmd == 'audio-delay':
            if len(a.args) != 2 or not a.args[1].isdigit():
                ap.error('audio-delay <audio> <ms>')
            kw['source'], kw['ms'] = audio_id(a.args[0]), int(a.args[1])
        else:
            if len(a.args) != 2:
                ap.error('audio-link <vídeo> <audio>|none')
            kw['video'], kw['source'] = resolve(st, a.args[0]), audio_id(a.args[1])
        a.cmd = a.cmd.replace('-', '_')
    elif a.cmd in ('phones', 'phones-gain'):
        if a.cmd == 'phones':
            if not a.args or a.args[0] not in ('on', 'off'):
                ap.error('phones on|off')
            kw['on'] = a.args[0] == 'on'
        else:
            try:
                kw['gain'] = int(a.args[0])
            except (IndexError, ValueError):
                ap.error('phones-gain <dB, de -40 a 0>')
        a.cmd = 'phones'
    elif a.cmd in ('camera', 'camera-reset'):
        if not a.args or a.cmd == 'camera' and len(a.args) not in (1, 3):
            ap.error('camera <source> [<control> <value>] | camera-reset <source>')
        st = c.call('get')['state']
        kw['source'] = resolve(st, a.args[0])
        if a.cmd == 'camera-reset':
            a.cmd = 'camera_reset'
        elif len(a.args) == 1:
            ctl = [x.get('controls') or [] for x in st['sources'] if x['id'] == kw['source']]
            print(json.dumps(ctl[0] if ctl else [], indent=2, ensure_ascii=False))
            return 0
        else:
            try:
                kw['control'], kw['value'] = a.args[1], int(a.args[2])
            except ValueError:
                ap.error('camera <source> <control> <integer>')
            a.cmd = 'camera_control'
    elif a.cmd == 'pip':
        for x in a.args:
            if x in ('tl', 'tr', 'bl', 'br'):
                kw['corner'] = x
            elif x in ('25', '33'):
                kw['size'] = int(x)
            else:
                ap.error('pip tl|tr|bl|br [25|33]')
    elif a.cmd in ('output', 'pause', 'lock', 'record'):
        if not a.args or a.args[0] not in ('on', 'off'):
            ap.error('%s on|off' % a.cmd)
        kw['on'] = a.args[0] == 'on'
        if a.cmd == 'pause' and len(a.args) > 1:
            kw['text'] = ' '.join(a.args[1:])
    r = c.call(a.cmd, **kw)
    print(json.dumps(r, ensure_ascii=False))
    return 0 if r.get('ok') else 1


if __name__ == '__main__':
    sys.exit(main())
