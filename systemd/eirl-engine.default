# /etc/default/eirl-engine — settings of eirl-engine.service, read by the engine (manager/internal/engine/config).
# Tras cambiarla: sudo systemctl restart eirl-engine
SOURCE=hdmi
SIGNAL_TIMEOUT=0

# Destino. Por defecto, listener en la Jetson (el visor del Mac hace pull de srt://<jetson>:9000).
SRT_URL=srt://:9000
SRT_MODE=listener
SRT_LATENCY=500
# Para emitir a un relay (caller), p. ej. una clave de EnhancedIRL:
#SRT_URL=srt://<host>:<puerto>
#SRT_MODE=caller
#SRT_STREAMID=publish:<clave>
#SRT_PASSPHRASE=
# SRTLA (bonding de varios enlaces a internet, ver SRTLA.md): SRT_URL=srtla://<relay>:<puerto SRTLA>,
# SRT_MODE=caller y SRT_LATENCY=2000. Necesita srtla_send y el dispatcher de enlaces (manager/build.sh).
#SRTLA_LOCAL_PORT=6000

VBITRATE=6000
ABITRATE=128
# Adaptive video bitrate (internal/engine/output): goes down with congestion to VBITRATE_MIN and
# slowly back up to VBITRATE. Recommended with SRTLA or a mobile network. The app manages it too.
#ABR=1
#VBITRATE_MIN=1000

# Mezclador (MIXER.md), por defecto: todas las fuentes a la vez (HDMI de la placa y USB) y lo que sale
# es el programa; SOURCE es la fuente principal (al aire al arrancar y la del audio). 0 = una sola fuente.
#MIXER=1

# on = emite | off = modo ensayo (captura con preview y vúmetro, sin el encoder principal ni SRT)
OUTPUT=on
# Para la app de gestión: preview en directo (H.264 640x360 + Opus por RTP a 127.0.0.1:5006/5008),
# vúmetro por UDP 127.0.0.1:5005, última muestra de estadísticas SRT en /run/eirl-engine/srt-stats.json.
# 0 = desactivado
LIVE=1
LEVELS=1
