+/*
+ * Jetson: el bloque de registros HDMI de 8 bits (0x8000+: HDMI-RX, EDID
+ * RAM...) solo autoincrementa la dirección I2C con CONFCTL.AUTOINDEX=1, que
+ * vale 0 tras el reset y el driver no activa hasta el final de
+ * initial_setup (después de varios accesos multibyte a 0x85xx). Para no
+ * depender de ese orden se trocean esos accesos en transferencias de 1 byte
+ * (verificado con i2ctransfer: con AUTOINDEX=0 todos los bytes caen en el
+ * primer registro).
+ */
+#define TC358743_NO_AUTOINC_BASE	0x8000
+
+static void __i2c_rd(struct v4l2_subdev *sd, u16 reg, u8 *values, u32 n);
+static void __i2c_wr(struct v4l2_subdev *sd, u16 reg, u8 *values, u32 n);
+
 static void i2c_rd(struct v4l2_subdev *sd, u16 reg, u8 *values, u32 n)
 {
+	u32 i;
+
+	if (reg < TC358743_NO_AUTOINC_BASE || n <= 1) {
+		__i2c_rd(sd, reg, values, n);
+		return;
+	}
+	for (i = 0; i < n; i++)
+		__i2c_rd(sd, reg + i, values + i, 1);
