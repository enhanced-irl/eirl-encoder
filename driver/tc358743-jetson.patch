+/*
+ * Jetson: reset por hardware en caliente. El PLL de audio del chip puede
+ * quedarse sin enganchar en frecuencia (AU_STATUS0.S_A_F_Lock = 0, sin reloj
+ * I2S) y ni los resets por software de SYSCTL ni reiniciar la Jetson lo
+ * sacan: solo quitarle la corriente. El pulso en RESETN deja el chip como
+ * recién encendido; aquí se reprograma entero (lo de initial_setup, los
+ * timings y el formato CSI vigentes y el EDID) sin reprobar el driver, que
+ * no se puede descargar mientras el VI lo tenga.
+ *
+ * Va en un work y no en s_ctrl: s_ctrl corre con el lock del ctrl_handler
+ * y el sondeo de interrupciones (que actualiza controles con ese lock) hay
+ * que pararlo y esperarlo antes de tocar el chip.
+ *
+ * Hacerlo con el pipeline parado: el CSI queda apagado hasta el siguiente
+ * s_stream(1). El hotplug baja y sube: la fuente vuelve a detectar la
+ * pantalla y renegocia.
+ */
+#define TC358743_CID_HW_RESET	(V4L2_CID_USER_TC358743_BASE + 2)
+
+static void tc358743_work_hw_reset(struct work_struct *work)
+{
+	struct tc358743_state *state = container_of(work,
+			struct tc358743_state, work_hw_reset);
+	struct v4l2_subdev *sd = &state->sd;
+	u16 edid_len = state->edid_blocks_written * EDID_BLOCK_SIZE;
+	int i;
+
+	v4l2_info(sd, "reset por hardware\n");
+
+	if (state->i2c_client->irq) {
+		disable_irq(state->i2c_client->irq);
+	} else {
+		del_timer_sync(&state->timer);
+		cancel_work_sync(&state->work_i2c_poll);
+	}
+	cancel_delayed_work_sync(&state->delayed_work_enable_hotplug);
 
+	tc358743_gpio_reset(state);
+
+	tc358743_initial_setup(sd);
+	/* s_dv_timings no reprograma si los timings no cambian: a mano */
+	tc358743_set_pll(sd);
+	tc358743_set_csi(sd);
+	tc358743_set_csi_color_space(sd);
+
+	tc358743_disable_edid(sd);
+	i2c_wr8(sd, EDID_LEN1, edid_len & 0xff);
+	i2c_wr8(sd, EDID_LEN2, edid_len >> 8);
+	for (i = 0; i < edid_len; i += EDID_BLOCK_SIZE)
+		i2c_wr(sd, EDID_RAM + i, state->edid + i, EDID_BLOCK_SIZE);
+
+	tc358743_init_interrupts(sd);
+	tc358743_enable_interrupts(sd, tx_5v_power_present(sd));
+	i2c_wr16(sd, INTMASK, ~(MASK_HDMI_MSK | MASK_CSI_MSK) & 0xffff);
+	if (tx_5v_power_present(sd))
+		tc358743_enable_edid(sd);
+
+	if (state->i2c_client->irq)
+		enable_irq(state->i2c_client->irq);
+	else
+		mod_timer(&state->timer,
+			  jiffies + msecs_to_jiffies(POLL_INTERVAL_MS));
+
+	tc358743_update_controls(sd);
+	v4l2_info(sd, "reset por hardware: chip reprogramado\n");
+}
+
+static int tc358743_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct tc358743_state *state = container_of(ctrl->handler,
+			struct tc358743_state, hdl);
+
+	switch (ctrl->id) {
+	case TC358743_CID_HW_RESET:
+		if (!state->reset_gpio)
+			return -ENODEV;
+		schedule_work(&state->work_hw_reset);
+		return 0;
+	}
+	return -EINVAL;
+}
