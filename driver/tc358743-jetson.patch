+/*
+ * Jetson: nivel del FIFO de vídeo (FIFOCTL) calculado para cada modo, en vez de
+ * un valor fijo. El CSI empieza a vaciar una línea cuando el FIFO llega a ese
+ * nivel (en palabras de 32 bits: 2 píxeles UYVY):
+ * - Si la línea entra más despacio de lo que sale por el CSI, hay que esperar
+ *   lo justo para que el CSI no alcance a la entrada a mitad de línea:
+ *   nivel = palabras de la línea × (1 - entrada/CSI). Es la fórmula que da el
+ *   374 de mainline: 1080p30 a 2 lanes/972 Mbps y 1080p60 a 4 lanes (373,3).
+ * - Si entra más deprisa (1080p50 a 2 lanes), conviene arrancar cuanto antes:
+ *   el FIFO acumula palabras × (1 - CSI/entrada) además del nivel, y la línea
+ *   cabe solo si el CSI la vacía antes de que acabe la siguiente.
+ * Con el parámetro fifo_level > 0 se fuerza un valor (diagnóstico).
+ */
+static u16 tc358743_fifo_level(struct v4l2_subdev *sd)
+{
+	struct tc358743_state *state = to_state(sd);
+	struct tc358743_platform_data *pdata = &state->pdata;
+	const struct v4l2_bt_timings *bt = &state->timings.bt;
+	u32 bpp = (state->mbus_fmt_code == MEDIA_BUS_FMT_UYVY8_1X16) ? 16 : 24;
+	u64 in_bps = (u64)bt->pixelclock * bpp;
+	u64 csi_bps = (u64)(pdata->refclk_hz / pdata->pll_prd) *
+		      pdata->pll_fbd * state->bus.num_data_lanes;
+	u64 htotal = V4L2_DV_BT_FRAME_WIDTH(bt);
+	u32 words = bt->width * bpp / 32;
+	u32 level, peak, load;
+
+	if (fifo_level > 0)
+		return min(fifo_level, 511);
+	if (!in_bps || !csi_bps || !htotal || words < 32)
+		return pdata->fifo_level;
+
+	if (in_bps < csi_bps) {
+		level = (words * (csi_bps - in_bps) + csi_bps - 1) / csi_bps;
+		peak = level;
+	} else {
+		level = 16;
+		peak = level + words * (in_bps - csi_bps) / in_bps;
+	}
+	level = clamp_t(u32, level, 16, min_t(u32, words - 16, 511));
+
+	/* % de la línea HDMI que tarda el CSI en mandarla (> 100 % = no cabe) */
+	load = (u64)bt->width * bpp * bt->pixelclock * 100 / (csi_bps * htotal);
+	if (load > 100)
+		v4l2_warn(sd, "%ux%u@%u no cabe: el CSI necesita el %u%% de cada línea\n",
+			  bt->width, bt->height, fps(bt), load);
+	else
+		v4l2_info(sd, "%ux%u@%u: FIFO %u (pico ~%u), CSI al %u%% de la línea\n",
+			  bt->width, bt->height, fps(bt), level, peak, load);
+
+	return level;
 }
 
